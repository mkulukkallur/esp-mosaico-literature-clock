# Keep the OTA writer only in the retained factory Recovery image. The normal
# application exposes the enter-Recovery RPC through iris_ota_support_start().
# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico literature_clock"
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000

# ---------------- Literature Clock additions ----------------
CONFIG_FREERTOS_HZ=1000
# CO5300 tearing-effect sync, as in the official LVGL hmi_demo
CONFIG_BSP_CO5300_ENABLE_TE=y
# LVGL rendering (the clock UI uses LVGL instead of GSP)
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DPI_DEF=60
# Quote text: embedded TrueType fonts rendered at any size, mixed in span groups
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=256
CONFIG_LV_USE_SPAN=y
CONFIG_LV_SPAN_SNIPPET_STACK_SIZE=128
# HTTPS for the timezone lookup (TLS buffers in PSRAM)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
